# Copy this file to .env and paste in the URL from your n8n Webhook node.
#
# While testing in the n8n editor use the Test URL (contains /webhook-test/)
# and click "Listen for test event" before each submission.
# Once the workflow is active, switch to the Production URL (contains /webhook/).
VITE_N8N_WEBHOOK_URL=http://localhost:5678/webhook-test/student-feedback
