    {
      "parameters": {
        "content": "## 1 · Receive and validate\nThe React form POSTs JSON to this webhook. The Code node trims every field and checks it, then the IF splits clean data from bad data.",
        "height": 420,
        "width": 700,
        "color": 7
      },
      "id": "Note: Receive",
      "name": "Note: Receive",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -100,
        60
      ]
    },
    {
      "parameters": {
        "content": "### Bad data\nReplies with a 400 and a list of what is wrong, so the form can point at the exact fields. Nothing is saved.",
        "height": 300,
        "width": 300,
        "color": 3
      },
      "id": "Note: Invalid",
      "name": "Note: Invalid",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        640,
        500
