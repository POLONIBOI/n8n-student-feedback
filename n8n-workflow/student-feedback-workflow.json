    {
      "parameters": {
        "content": "## 3 · Save, email, reply\nAdds a row to the Feedback sheet, emails the student a thank-you, then answers the form. If Gmail fails the student still gets a success reply because the row is already saved.",
        "height": 420,
        "width": 700,
        "color": 6
      },
      "id": "Note: Store",
      "name": "Note: Store",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        1180,
        0
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "student-feedback",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "3b1f6a2e-7c4d-4e8a-9f10-2a6b5c8d9e01",
      "name": "Receive Feedback",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        300
      ],
      "webhookId": "8e4c2d71-5a9b-4f36-b0c8-1d7e3f5a6b92"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// The Webhook node puts the JSON the form sent under \"body\".\nconst body = $json.body ?? {};\n\nconst text = (value) => (typeof value === 'string' ? value.trim() : '');\n\nconst name = text(body.name).replace(/\\s+/g, ' ');\nconst email = text(body.email).toLowerCase();\nconst course = text(body.course);\nconst message = text(body.message);\nconst rating = Number(body.rating);\n\n// Collect every problem instead of stopping at the first one,\n// so the form can highlight all the bad fields in one go.\nconst errors = [];\nconst fail = (field, reason) => errors.push({ field, message: reason });\n\nif (!name) fail('name', 'Student name is required.');\n\nif (!email) fail('email', 'Email address is required.');\nelse if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/.test(email)) fail('email', 'Email address is not valid.');\n\nif (!course) fail('course', 'Course name is required.');\n\nif (body.rating === undefined || body.rating === null || body.rating === '') {\n  fail('rating', 'Rating is required.');\n} else if (!Number.isInteger(rating) || rating < 1 || rating > 5) {\n  fail('rating', 'Rating must be a whole number from 1 to 5.');\n}\n\nif (!message) fail('message', 'Feedback message is required.');\nelse if (message.length < 10) fail('message', 'Feedback message must be at least 10 characters.');\nelse if (message.length > 1000) fail('message', 'Feedback message must be 1000 characters or fewer.');\n\n// The message goes into an HTML email later, so escape it here once.\nconst escapeHtml = (value) =>\n  value.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\n\nreturn {\n  json: {\n    isValid: errors.length === 0,\n    errors,\n    name,\n    firstName: name.split(' ')[0],\n    email,\n    course,\n    rating,\n    message,\n    messageHtml: escapeHtml(message).replace(/\\n/g, '<br>'),\n    reference: 'FB-' + Date.now().toString(36).toUpperCase(),\n    submittedAt: $now.toFormat('yyyy-MM-dd HH:mm'),\n  },\n};"
      },
      "id": "a7d3e9c1-2b4f-4a6d-8e0c-5f1b3d7a9c02",
