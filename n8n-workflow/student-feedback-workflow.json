    },
    {
      "parameters": {
        "content": "## 2 · Check the rating\n1 or 2 → **Needs Attention**\n3 to 5 → **Positive**\n\nDone before saving so the status lands in the same row.",
        "height": 600,
        "width": 520,
        "color": 4
      },
      "id": "Note: Rating",
      "name": "Note: Rating",
